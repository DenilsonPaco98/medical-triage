# Application
ENV=production
DEBUG=False
LOG_LEVEL=INFO

# Data & Model
MODEL_NAME=distilbert-base-uncased
MAX_SEQ_LENGTH=256
BATCH_SIZE=32
LEARNING_RATE=2e-5
NUM_EPOCHS=3
DEVICE=cuda

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=medical-review-sentiment

# Airflow
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# API
API_HOST=0.0.0.0
API_PORT=8000

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Kaggle (optional, for dataset download)
KAGGLE_USERNAME=denilsonpacoquispe
KAGGLE_KEY=a546297156ac6c5762b5cf70a07fe714

# =====================================================================
# Weights & Biases (Optional)
# =====================================================================
WANDB_ENABLED=false
WANDB_PROJECT=medical-review-sentiment
WANDB_ENTITY=your-team
WANDB_API_KEY=

# =====================================================================
# Prefect Configuration
# =====================================================================
PREFECT_HOME=./prefect
PREFECT_API_URL=http://localhost:4200/api
PREFECT_FLOW_LOG_LEVEL=INFO

# =====================================================================
# API Server
# =====================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501"]

# =====================================================================
# TorchServe
# =====================================================================
TORCHSERVE_NANNY_THREAD=true
TS_INFERENCE_ADDRESS=http://localhost:8080
TS_MANAGEMENT_ADDRESS=http://localhost:8081
TS_METRICS_ADDRESS=http://localhost:8082
TS_NUMBER_OF_GPU=0

# =====================================================================
# Monitoring & Observability
# =====================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# =====================================================================
# Evidently AI (Data Drift Detection)
# =====================================================================
EVIDENTLY_DASHBOARD_PORT=8888
EVIDENTLY_PROJECT_PATH=./evidently_project

# =====================================================================
# PostgreSQL (Optional - for MLflow backend)
# =====================================================================
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_password
POSTGRES_DB=mlflow_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =====================================================================
# S3/MinIO (Optional - for model artifacts)
# =====================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=medical-review-models
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# =====================================================================
# Slack Notifications (Optional)
# =====================================================================
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# =====================================================================
# Sentry (Error Tracking)
# =====================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# =====================================================================
# Feature Store (Optional - Feast)
# =====================================================================
FEAST_REGISTRY_PATH=./feast_registry.db
FEAST_OFFLINE_STORE=file

# =====================================================================
# OpenAI API (Optional - for LLM-based analysis)
# =====================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
